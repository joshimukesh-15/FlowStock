# ==============================================================================
# FLOWSTOCK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env before starting the backend and frontend services.
# RULE: Never commit real passwords, secret keys, or credentials to version control.
# ==============================================================================

# Application & Environment Settings
PROJECT_NAME="FlowStock"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Cryptography
# IMPORTANT: In production, generate a secure random 64-char key using:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="flowstock-dev-secret-key-change-in-production-only"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Connections (Free-Only / Native Local Stack)
# Local Native PostgreSQL (Optional):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/flowstock_db"
# Native SQLite Fallback (Zero-Docker / Zero-Configuration):
DATABASE_FALLBACK_SQLITE="sqlite+aiosqlite:///./flowstock.db"

# Storage
STORAGE_LOCAL_PATH="./uploads"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Frontend Public Variables (used by Next.js client)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api/v1/ws"
